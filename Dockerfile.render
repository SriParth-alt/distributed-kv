# Single-container variant for PaaS hosts (Render/Fly/Railway) that expose one
# port: runs the full 3-node cluster plus the React dashboard behind $PORT.
# For the real one-container-per-node topology, use Dockerfile + compose.

FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY kvstore/ kvstore/
COPY launch_cluster.py ./
COPY --from=web /web/dist web/dist

ENV PORT=8001
# --revive keeps the public failover demo self-healing after visitors crash nodes
CMD ["sh", "-c", "python launch_cluster.py --nodes 3 --host 0.0.0.0 --revive 15 --base-port ${PORT}"]
